{
  "name": "northstar-supply",
  "version": "1.0.0",
  "private": true,
  "description": "Example React 18 server-rendered storefront used to benchmark specializing React SSR (Prepack Revived)",
  "main": "dist/app.js",
  "scripts": {
    "build": "node scripts/build.js",
    "build:prepack": "node scripts/build-prepack.js",
    "build:hybrid": "node scripts/build-hybrid.js",
    "build:all": "npm run build && npm run build:prepack && npm run build:hybrid",
    "test": "node test/compare.js",
    "start": "node server.js",
    "render": "node scripts/render.js"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/plugin-transform-react-jsx": "^7.25.0",
    "esbuild": "^0.28.2"
  },
  "license": "MIT"
}
